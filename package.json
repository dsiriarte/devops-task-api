{
  "name": "devops-task-api",
  "version": "1.1.0",
  "description": "Aplicacion web de ejemplo (API + UI) para el laboratorio CI/CD con seguridad y monitoreo - Fundamentos DevOps, Universidad de La Sabana",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node scripts/smoke-test.js"
  },
  "keywords": [
    "devops",
    "cicd",
    "github-actions",
    "jenkins",
    "kubernetes"
  ],
  "author": "David Santiago Iriarte Zamora",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
