// ---------------------------------------------------------------------------
// Variante de DEMOSTRACION del pipeline de CD.
//
// El Jenkinsfile de la raiz del repositorio es la definicion real y completa
// del pipeline de entrega continua. Esta variante replica exactamente los
// mismos stages, pero sustituye por trazas las operaciones que exigen un
// demonio Docker, un registro y un cluster de Kubernetes, de modo que el
// pipeline pueda ejecutarse de principio a fin en un Jenkins local y generar
// las evidencias de ejecucion solicitadas en la guia de actividades.
//
// Uso: se configura como pipeline "Pipeline script" en un job de Jenkins.
// ---------------------------------------------------------------------------

pipeline {
    agent any

    environment {
        // El agente integrado de Jenkins no hereda el PATH del shell de usuario;
        // se anade explicitamente la ruta de Node.js del entorno local.
        PATH               = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
        REGISTRY           = 'docker.io'
        REGISTRY_NAMESPACE = 'dsiriarte'
        IMAGE_NAME         = 'devops-task-api'
        IMAGE_TAG          = "${env.BUILD_NUMBER}-demo"
        FULL_IMAGE         = "${REGISTRY}/${REGISTRY_NAMESPACE}/${IMAGE_NAME}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'staging', 'prod'],
               description: 'Entorno de destino del despliegue')
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=== STAGE 1: Clonando el repositorio ==='
                // checkout scm toma el repositorio configurado en el job, de modo
                // que el mismo Jenkinsfile sirve para el repo local y para GitHub.
                checkout scm
                sh 'ls -la && git log --oneline -1'
            }
        }

        stage('Instalar dependencias') {
            steps {
                echo '=== STAGE 2: Instalando dependencias (npm ci) ==='
                sh 'npm ci'
            }
        }

        stage('Calidad y pruebas') {
            parallel {
                stage('Analisis estatico') {
                    steps {
                        echo '=== STAGE 3a: Analisis estatico con ESLint ==='
                        sh 'npm run lint'
                    }
                }
                stage('Pruebas automatizadas') {
                    steps {
                        echo '=== STAGE 3b: Pruebas unitarias y de integracion ==='
                        sh 'npm test'
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        stage('Construir imagen Docker') {
            steps {
                echo '=== STAGE 4: Construyendo la imagen Docker ==='
                sh """
                    echo "[simulado] docker build -t ${FULL_IMAGE}:${IMAGE_TAG} ."
                    echo "Dockerfile que se construiria:"
                    head -20 Dockerfile
                """
            }
        }

        stage('Escaneo de seguridad (Trivy)') {
            steps {
                echo '=== STAGE 5: Escaneo de vulnerabilidades de la imagen ==='
                sh """
                    echo "[simulado] trivy image --severity HIGH,CRITICAL ${FULL_IMAGE}:${IMAGE_TAG}"
                    echo "Auditoria real de dependencias del proyecto:"
                    npm audit --audit-level=high || true
                """
            }
        }

        stage('Publicar en el registro') {
            steps {
                echo '=== STAGE 6: Publicando la imagen en el registro ==='
                sh """
                    echo "[simulado] docker login ${REGISTRY} (credencial: dockerhub-credentials)"
                    echo "[simulado] docker push ${FULL_IMAGE}:${IMAGE_TAG}"
                    echo "[simulado] docker push ${FULL_IMAGE}:latest"
                """
            }
        }

        stage('Actualizar manifiestos (GitOps)') {
            steps {
                echo '=== STAGE 7: Actualizando los manifiestos de Kubernetes ==='
                sh """
                    sed -i.bak 's|image: .*${IMAGE_NAME}:.*|image: ${FULL_IMAGE}:${IMAGE_TAG}|' k8s/deployment.yaml
                    rm -f k8s/deployment.yaml.bak
                    echo "Etiqueta de imagen resultante en el manifiesto:"
                    grep 'image:' k8s/deployment.yaml
                """
            }
        }

        stage('Desplegar en Kubernetes') {
            steps {
                echo "=== STAGE 8: Desplegando en el entorno ${params.DEPLOY_ENV} ==="
                sh """
                    echo "[simulado] kubectl --namespace=${params.DEPLOY_ENV} apply -f k8s/"
                    echo "[simulado] kubectl --namespace=${params.DEPLOY_ENV} rollout status deployment/${IMAGE_NAME}"
                    echo "Manifiestos que se aplicarian:"
                    ls -1 k8s/
                """
            }
        }

        stage('Verificacion post-despliegue') {
            steps {
                echo '=== STAGE 9: Prueba de humo contra el servicio desplegado ==='
                sh """
                    echo "[simulado] kubectl run smoke-test --image=curlimages/curl -- curl -sf http://${IMAGE_NAME}/healthz"
                    echo "Prueba de humo real ejecutada contra la aplicacion:"
                    npm run smoke
                """
            }
        }

        stage('Aprobacion para produccion') {
            when {
                expression { return params.DEPLOY_ENV == 'prod' }
            }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    input message: "Confirmar la promocion de ${IMAGE_TAG} a produccion", ok: 'Promover'
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completado: ${FULL_IMAGE}:${IMAGE_TAG} desplegado en ${params.DEPLOY_ENV}"
        }
        failure {
            echo 'El pipeline fallo. En el pipeline real se ejecutaria kubectl rollout undo.'
        }
        always {
            echo 'Limpieza finalizada.'
        }
    }
}
